# =============================================================================
# DWM Independent Analytics Subsystem Configuration
# =============================================================================

# Server Port
PORT=5001
DWM_PORT=5001

# Client URL (for CORS)
CLIENT_URL=http://localhost:5174
DWM_CLIENT_URL=http://localhost:5174

# Data Warehouse Connection (dwh schema)
# Connect to your standalone PostgreSQL or local PGlite development instance
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres
DWM_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Environment
NODE_ENV=development
